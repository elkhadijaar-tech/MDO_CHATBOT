# --- MDO CHATBOT : configuration ---
# Sans clé API, l'application démarre en MODE DÉMO (réponses extraites des bases, sans IA).
# Fournisseur : anthropic | openai | gemini | openai-compatible (avec LLM_BASE_URL)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Optionnel : modèle de secours (la réponse indique toujours quel modèle l'a générée)
LLM_FALLBACK_MODEL=
# Optionnel : URL de base pour une API compatible OpenAI
LLM_BASE_URL=

# Optionnel : mot de passe des pages d'administration (bases de connaissances, diagnostic).
# Vide = accès réservé à l'ordinateur qui héberge l'application (127.0.0.1).
ADMIN_PASSWORD=

# Généré automatiquement au premier lancement
SECRET_KEY=32c4a4689ed05111c2c6c35d81232278ddcc096f818a5abe462a74d47ad2043d

HOST=127.0.0.1
PORT=5000
RATE_LIMIT_PER_MIN=20
MAX_MESSAGE_LEN=1000
